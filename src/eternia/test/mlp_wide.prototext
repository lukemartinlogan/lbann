# A deliberately WIDE variant of mlp.prototext, used only by
# LBANN_ETERNIA_CHECK.
#
# It exists because the narrow model cannot test the backward-input
# kernel. There, dX = W * dC sums over just 4 and 32 terms, few enough
# that the paged kernel matches El::Gemm BITWISE -- which is not evidence
# of anything, since a check that cannot distinguish two correct
# implementations also cannot distinguish a correct one from a subtly
# wrong one.
#
# 1024 -> 512 -> 4 makes fc1's backward sum 512 terms deep, where
# reassociated floating-point accumulation must differ from cuBLAS and
# the comparison starts carrying information. It also makes W 2 MB, so it
# spans many pages at the default granularity rather than one or two.
trainer { mini_batch_size: 256 }
data_reader {
  reader {
    name: "synthetic"
    role: "train"
    shuffle: false
    num_samples: 256
    num_labels: 4
    synth_dimensions: "1024"
    validation_fraction: 0.0
    absolute_sample_count: 0
    fraction_of_data_to_use: 1.0
  }
}
model {
  data_layout: "data_parallel"
  num_epochs: 3

  layer { name: "data" children: "fc1" data_layout: "data_parallel"
          input { data_field: "samples" } }
  layer { name: "lbl" data_layout: "data_parallel"
          input { data_field: "labels" } }
  layer { parents: "data" name: "fc1" data_layout: "data_parallel"
          fully_connected { num_neurons: 512 has_bias: false transpose: true } }
  layer { parents: "fc1" name: "relu1" data_layout: "data_parallel" relu {} }
  layer { parents: "relu1" name: "fc2" data_layout: "data_parallel"
          fully_connected { num_neurons: 4 has_bias: false transpose: true } }
  layer { parents: "fc2" name: "prob" data_layout: "data_parallel" softmax {} }
  layer { parents: "prob" parents: "lbl" name: "ce" data_layout: "data_parallel" cross_entropy {} }

  objective_function { layer_term { layer: "ce" } }
  callback { print { interval: 1 } }
}
optimizer { sgd { learn_rate: 0.01 momentum: 0.0 } }
